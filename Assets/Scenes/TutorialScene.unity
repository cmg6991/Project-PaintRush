  wideSingleKeySlot: {fileID: 546857636}
  leftKeySlot: {fileID: 1475784313}
  rightKeySlot: {fileID: 1754809959}
  guideDataList:
  - step: 0
    guideText: "[A / D] \uD0A4\uB97C \uB20C\uB7EC \uC88C\uC6B0\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    keySprites:
    - {fileID: 6091706668691328248, guid: 3c37df82747906546b99948fd0545ec0, type: 3}
    - {fileID: 5119971492981962814, guid: 0da5d7655cd7113498660ae7d63f5251, type: 3}
    isWideSingleKey: 0
    autoHideDelay: 4
  - step: 1
    guideText: "[Space] \uD0A4\uB97C \uB20C\uB7EC \uC9C0\uD615\uC744 \uB118\uC5B4\uAC00\uC138\uC694."
    keySprites:
    - {fileID: -7361832422959977995, guid: 6651effb5e6f9994888cc21cfb634cc5, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 4
  - step: 3
    guideText: "[W / S] \uD0A4\uB97C \uB20C\uB7EC \uC0AC\uB2E4\uB9AC\uB97C \uC624\uB974\uB0B4\uB9AC\uC138\uC694."
    keySprites:
    - {fileID: -7806759438263799239, guid: d0b7dc84d899b8a4fb885837bd0170e2, type: 3}
    - {fileID: 911841031958816375, guid: bdf675333287ea641a73ce97dc00a8a3, type: 3}
    isWideSingleKey: 0
    autoHideDelay: 5
  - step: 4
    guideText: "[W] \uD0A4\uB85C \uD589\uAC70\uC5D0 \uB9E4\uB2EC\uB9B0 \uD6C4, [Space]\uB97C
      \uB20C\uB7EC \uB2E4\uC74C \uD589\uAC70\uB85C \uAC74\uB108\uB6F0\uC138\uC694!"
    keySprites:
    - {fileID: -7806759438263799239, guid: d0b7dc84d899b8a4fb885837bd0170e2, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 0
  - step: 5
    guideText: "\uBB34\uAE30\uAC00 \uC7A5\uCC29\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD0C0\uC77C\uB85C
      \uAC00\uC11C \uC0C9\uC744 \uD761\uC218\uD558\uC138\uC694."
    keySprites:
    - {fileID: -2432502294506506857, guid: f96ce6f96440c1644b2e090dd52df174, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 3
  - step: 2
    guideText: "\uB9C8\uC6B0\uC2A4\uB85C \uBC29\uD5A5\uC744 \uC870\uC900\uD558\uACE0
      [\uC88C\uD074\uB9AD]\uC73C\uB85C \uBB3C\uAC10\uC744 \uBC1C\uC0AC\uD558\uC138\uC694!"
    keySprites:
    - {fileID: -8840538120556641855, guid: 6651effb5e6f9994888cc21cfb634cc5, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 4
  - step: 7
    guideText: "\uCD1D\uAE30 \uD0C4\uD658\uACFC \uB3D9\uC77C\uD55C \uC0C9\uC0C1\uC758
      \uBAAC\uC2A4\uD130\uB97C \uC0AC\uACA9\uD558\uC5EC \uCC98\uCE58\uD558\uC138\uC694!"
    keySprites:
    - {fileID: 7392646444851725707, guid: e196e72d56cb55d49bd37eadc3491199, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 4
  - step: 8
    guideText: "\uD314\uB808\uD2B8 : Q \uBC84\uD2BC\uC73C\uB85C \uD53C\uBC84\uD0C0\uC784
      \uBC1C\uB3D9!!\n\uBAA8\uB4E0 \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4!"
    keySprites:
    - {fileID: 5922471645474089186, guid: 4fe3dad6070c6af47a5bb878b75f865d, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 4
  - step: 6
    guideText: "\uBAAC\uC2A4\uD130\uB97C \uC7A1\uACE0 \uD544\uB4DC\uC758 \uBB3C\uAC10
      \uC544\uC774\uD15C\uC5D0 \n\uB2E4\uAC00\uAC00 \uD0C4\uD658 \uC0C9\uC0C1\uC744
      \uCDA9\uC804\uD558\uC138\uC694!\n(\uD314\uB808\uD2B8 \uC2A4\uD0AC \uD65C\uC131
      \uC870\uAC74)"
    keySprites:
    - {fileID: 5007347937705249242, guid: 87d99363e61b36b4293e3dbf1667c528, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 4
  - step: 9
    guideText: "\uC815\uD574\uC9C4 \uBAAC\uC2A4\uD130\uB97C \uC7A1\uACE0 \uC0C9\uC744
      \uB123\uC73C\uBA74\n\uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\uB85C \uAC08 \uC218
      \uC788\uC5B4\uC694~"
    keySprites:
    - {fileID: 5628198344725179689, guid: ac4e7761ad96de24697721d80286e255, type: 3}
    isWideSingleKey: 1
    autoHideDelay: 4
